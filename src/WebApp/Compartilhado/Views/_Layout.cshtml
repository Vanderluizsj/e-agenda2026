<!DOCTYPE html>
<html lang="pt-BR" >
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    @* Importação do CSS do Bootstrap *@
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    @* Importação dos icones*@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    @* Importação do nosso CSS personalizado *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <title>@ViewBag.Titulo - e-Agenda</title>
</head>
<body data-bs-theme="auto" class="@ViewBag.BodyClass d-flex flex-column min-vh-100">
    @* Barra de Navegação *@
    <nav class="navbar navbar-expand-lg navbar-glass">
        <div class="container">
            <a class="navbar-brand fw-semibold text-primary" asp-controller="Home" asp-action="Index">e-Agenda</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="menuPrincipal">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link fw-medium" asp-controller="Home" asp-action="Index">Início</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-medium" asp-controller="Categoria" asp-action="Listar">Categorias</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-medium" asp-controller="Despesa" asp-action="Listar">Despesas</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-medium" asp-controller="Tarefa" asp-action="Listar">Tarefas</a>
                    </li>
                    
                    <li class="nav-item ms-3">
                        <button id="themeToggle"
                            class="btn btn-sm btn-outline-secondary"
                            type="button">
                            <i id="themeIcon" class="bi bi-moon"></i>
                        </button>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    @* Cabeçalho da Página *@
    <header class="container py-4">
        <h2 class="page-title fw-bold text-body-emphasis">@ViewBag.Titulo</h2>
    </header>

    @* Conteúdo da Página *@
    <main class="container pb-5">
        <div class="main-glass-panel">
            @RenderBody()
        </div>
    </main>

    @* Importação do JavaScript do Bootstrap *@
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" 
    integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" 
    crossorigin="anonymous"></script>
     @* Importação do JavaScript personalizado *@
    <script src="~/js/theme.js"></script>
</body>
<footer class="border-top py-4 mt-auto"
        style="
            background-color: var(--bs-tertiary-bg);
            backdrop-filter: blur(10px);
        ">
    <div class="container">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">

            <div class="text-body-secondary small text-center text-md-start">
                &copy; @DateTime.Now.Year
                <span>e-Agenda</span>
                <span class="mx-1">·</span>
                <span>Desenvolvido por <strong>Vanderluiz Da Rosa De Oliveira</strong> durante a 
                <a href="https://www.academiadoprogramador.net/inicio"
                target="_blank"
                >Academia Do Programador</a></span>
            </div>

            <div class="d-flex gap-3">
                <a href="https://www.linkedin.com/in/vanderluiz/"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="text-body-secondary text-decoration-none">
                    <i class="bi bi-linkedin me-1"></i>
                    LinkedIn
                </a>

                <a href="https://github.com/Vanderluizsj"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="text-body-secondary text-decoration-none">
                    <i class="bi bi-github me-1"></i>
                    GitHub
                </a>
            </div>

        </div>
    </div>
</footer>
</html>