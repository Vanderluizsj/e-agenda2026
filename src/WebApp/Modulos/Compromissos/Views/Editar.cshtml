@{
    Layout = "_Layout";
    ViewBag.Titulo = "Edição de Compromisso";
}

@model EditarCompromissoViewModel;

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Editar" asp-route-id="@Model.Id" method="post">
    <div class="mb-3">
        <label asp-for="Assunto" class="form-label fw-semibold text-primary text-uppercase small">Assunto</label>
        <input asp-for="Assunto" type="text" class="form-control">
        <span asp-validation-for="Assunto" class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DataDeOcorrencia" class="form-label fw-semibold text-primary text-uppercase small">Data de Ocorrência</label>
        <input asp-for="DataDeOcorrencia" type="date" class="form-control">
        <span asp-validation-for="DataDeOcorrencia" class="text-danger small fw-semibold"></span>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label asp-for="HoraDeInicio" class="form-label fw-semibold text-primary text-uppercase small">Hora de Início</label>
            <input asp-for="HoraDeInicio" type="time" class="form-control">
            <span asp-validation-for="HoraDeInicio" class="text-danger small fw-semibold"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="HoraDeTermino" class="form-label fw-semibold text-primary text-uppercase small">Hora de Término</label>
            <input asp-for="HoraDeTermino" type="time" class="form-control">
            <span asp-validation-for="HoraDeTermino" class="text-danger small fw-semibold"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Tipo" class="form-label fw-semibold text-primary text-uppercase small">Tipo de Compromisso</label>
        <select asp-for="Tipo" class="form-select">
            <option value="Presencial">Presencial</option>
            <option value="Online">Remoto / Online</option>
        </select>
        <span asp-validation-for="Tipo" class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Local" class="form-label fw-semibold text-primary text-uppercase small">Local ou Link</label>
        <input asp-for="Local" type="text" class="form-control">
        <span asp-validation-for="Local" class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="IdContato" class="form-label fw-semibold text-primary text-uppercase small">Contato (Opcional)</label>
        <select asp-for="IdContato" class="form-select">
            <option value="">Sem contato</option>
            @foreach (ContatoDto contato in Model.ContatosDisponiveis)
            {
                <option value="@contato.Id">@contato.Nome</option>
            }
        </select>
        <span asp-validation-for="IdContato" class="text-danger small fw-semibold"></span>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">Voltar</a>
        <button class="btn btn-primary rounded-pill px-4" type="submit">Confirmar</button>
    </div>
</form>

